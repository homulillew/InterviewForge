        "evidence_id": {
          "maxLength": 16000,
          "minLength": 1,
          "title": "Evidence Id",
          "type": "string"
        },
        "relevance_score": {
          "minimum": 0,
          "title": "Relevance Score",
          "type": "number"
        },
        "reasons": {
          "items": {
            "maxLength": 16000,
            "minLength": 1,
            "type": "string"
