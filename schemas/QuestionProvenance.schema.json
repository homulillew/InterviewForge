{
  "$defs": {
    "ChallengeOperator": {
      "enum": [
        "WHY_NECESSARY",
        "WHY_NOT_SIMPLER",
        "WHY_NOT_ALTERNATIVE",
        "MECHANISM_PRESSURE",
        "IMPLEMENTATION_PRESSURE",
        "OWNERSHIP_PRESSURE",
        "METRIC_PRESSURE",
        "BASELINE_PRESSURE",
        "FAILURE_PRESSURE",
        "BOUNDARY_PRESSURE",
        "SCALE_PRESSURE",
        "DEBUG_PRESSURE",
        "COUNTEREXAMPLE",
        "CONSISTENCY_PRESSURE",
        "FUNDAMENTAL_DRILL"
      ],
      "title": "ChallengeOperator",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "resume_statement_id": {
      "maxLength": 16000,
      "minLength": 1,
      "title": "Resume Statement Id",
      "type": "string"
    },
    "atomic_claim_id": {
      "maxLength": 16000,
      "minLength": 1,
      "title": "Atomic Claim Id",
      "type": "string"
    },
    "attack_surface_id": {
      "maxLength": 16000,
      "minLength": 1,
      "title": "Attack Surface Id",
      "type": "string"
    },
    "corpus_match_ids": {
      "items": {
        "type": "string"
      },
      "title": "Corpus Match Ids",
      "type": "array"
    },
    "probe_pattern_ids": {
      "items": {
        "type": "string"
      },
      "title": "Probe Pattern Ids",
      "type": "array"
    },
    "transition_ids": {
      "items": {
        "type": "string"
      },
      "title": "Transition Ids",
      "type": "array"
    },
    "challenge_operator": {
      "$ref": "#/$defs/ChallengeOperator"
    },
    "style_profile_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Style Profile Id"
    },
    "style_backoff_path": {
      "items": {
        "type": "string"
      },
      "title": "Style Backoff Path",
      "type": "array"
    },
    "adaptation_reason": {
      "maxLength": 16000,
      "minLength": 1,
      "title": "Adaptation Reason",
      "type": "string"
    },
    "resume_relevance": {
      "default": 1,
      "maximum": 1,
      "minimum": 0,
      "title": "Resume Relevance",
      "type": "number"
    },
    "corpus_support": {
      "default": 0,
      "maximum": 1,
      "minimum": 0,
      "title": "Corpus Support",
      "type": "number"
    },
    "style_confidence": {
      "default": 0,
      "maximum": 1,
      "minimum": 0,
      "title": "Style Confidence",
      "type": "number"
    },
    "origin": {
      "default": "authored_baseline",
      "enum": [
        "authored_baseline",
        "corpus",
        "migration",
        "human_retest"
      ],
      "title": "Origin",
      "type": "string"
    }
  },
  "required": [
    "resume_statement_id",
    "atomic_claim_id",
    "attack_surface_id",
    "challenge_operator",
    "adaptation_reason"
  ],
  "title": "QuestionProvenance",
  "type": "object"
}
