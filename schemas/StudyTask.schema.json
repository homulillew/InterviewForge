            "mechanism",
            "design_decision",
            "alternative_comparison",
            "failure_mode",
            "debugging",
            "implementation",
            "system_design",
            "performance_evaluation",
            "project_improvement",
            "from_scratch",
            "debug_broken",
            "extend",
            "optimize",
            "mini_evaluation",
            "ablation"
